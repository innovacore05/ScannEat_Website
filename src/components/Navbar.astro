---
const appUrl = import.meta.env.PUBLIC_APP_URL;
---

<header class="w-full  bg-brand-mint-dark "> <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

<!-- Logo -->
<a href="#inicio">
  <img
    src="/public/logoscaneat.svg"
    alt="Scan n' Eat"
    class="h-10 w-auto"
  />
</a>

<!-- barra de navegacion opciones -->
<nav class="hidden items-center gap-8 md:flex">
  <a
    href="#inicio"
    class="font-medium text-white transition hover:text-teal-100"
  >
    Inicio
  </a>

  <a
    href="#nosotros"
    class="font-medium text-white transition hover:text-teal-100"
  >
    Nosotros
  </a>

  <a
    href="#funcionalidades"
    class="font-medium text-white transition hover:text-teal-100"
  >
    Funcionalidades
  </a>

  <a
    href="#planes"
    class="font-medium text-white transition hover:text-teal-100"
  >
    Planes
  </a>

  <a
    href="#contacto"
    class="font-medium text-white transition hover:text-teal-100"
  >
    Contacto
  </a>
</nav>

<!-- registro e inicio de sesion -->
<div class="flex items-center gap-3">
  <a
    href={`${appUrl}/register`}
    class="rounded-lg border-2 border-white px-4 py-2 font-semibold text-white transition hover:bg-white hover:text-teal-500"
  >
    Registrarse
  </a>

  <a
    href={`${appUrl}/login`}
    class="rounded-lg bg-white px-4 py-2 font-semibold text-teal-500 transition hover:bg-teal-50"
  >
    Iniciar sesión
  </a>
</div>

</div> 
</header>