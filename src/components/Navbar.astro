---
const appUrl = import.meta.env.PUBLIC_APP_URL;
const { onLight = false } = Astro.props;

const link = onLight
  ? "text-brand-mint-dark hover:text-brand-mint-darker"
  : "text-white hover:text-teal-100 group-data-[scrolled=true]/nav:text-brand-mint-dark group-data-[scrolled=true]/nav:hover:text-brand-mint-darker";

const btn = onLight
  ? "bg-brand-mint-dark text-white hover:bg-brand-mint-dark/85"
  : "bg-white text-brand-mint-darker hover:bg-white/85 group-data-[scrolled=true]/nav:bg-brand-mint-dark group-data-[scrolled=true]/nav:text-white group-data-[scrolled=true]/nav:hover:bg-brand-mint-dark/85";

const menuBtn = onLight
  ? "text-brand-mint-dark"
  : "text-white group-data-[scrolled=true]/nav:text-brand-mint-dark";
---

<header
  id="navbar"
  data-light={onLight}
  data-scrolled="false"
 class="group/nav fixed top-0 left-0 z-50 w-full translate-y-0 transition-all duration-300 data-[scrolled=true]:bg-white"
>
 <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6">

    <!-- Logo + links juntos a la izquierda -->
    <div class="flex items-center gap-8">
      {onLight ? (
        <img src="/logoscaneat-color.svg" alt="Scan n' Eat" class="h-8 w-auto" />
      ) : (
        <>
          <img
            src="/logoscaneat.svg"
            alt="Scan n' Eat"
            class="h-8 w-auto group-data-[scrolled=true]/nav:hidden"
          />
          <img
            src="/logoscaneat-color.svg"
            alt="Scan n' Eat"
            class="hidden h-8 w-auto group-data-[scrolled=true]/nav:block"
          />
        </>
      )}

      <nav class="hidden items-center gap-8 md:flex">
        <a href="/#inicio" class={`font-medium transition ${link}`}>Inicio</a>
        <a href="/#funcionalidades" class={`font-medium transition ${link}`}>Funcionalidades</a>
        <a href="/aboutUs#innovacore" class={`font-medium transition ${link}`}>Nosotros</a>
      </nav>
    </div>

    <!-- registro -->
    <div class="hidden items-center gap-3 md:flex">
      <a
        href={`${appUrl}/register`}
        class={`rounded-4xl px-4 py-1 font-semibold transition-colors duration-200 ${btn}`}
      >
        Registrarse
      </a>
    </div>

    <!-- botón menú celular -->
    <button
      id="menu-toggle"
      class={`relative z-50 md:hidden ${menuBtn}`}
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg id="icon-open" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="hidden h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<!-- menú móvil desplegable (fuera del header para que su "fixed" mida contra la pantalla) -->
<div
  id="mobile-menu"
  class="fixed inset-0 top-0 z-40 hidden h-screen w-full -translate-y-4 flex-col items-center justify-center gap-8 bg-brand-mint-dark px-6 opacity-0 transition-all duration-300 ease-out md:hidden"
>
  <a href="/#inicio" class="text-2xl font-medium text-white">Inicio</a>
  <a href="/#funcionalidades" class="text-2xl font-medium text-white">Funcionalidades</a>
  <a href="/aboutUs#innovacore" class="text-2xl font-medium text-white">Nosotros</a>

  <div class="flex w-full max-w-xs flex-col gap-3 pt-4">
    <a href={`${appUrl}/register`} class="rounded-lg border-2 border-white px-4 py-3 text-center font-semibold text-white">
      Registrarse
    </a>
    <a href={`${appUrl}/login`} class="rounded-lg bg-white px-4 py-3 text-center font-semibold text-brand-mint-dark">
      Iniciar sesión
    </a>
  </div>
</div>

<script>
  import { animate } from "motion";

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  const navbar = document.getElementById("navbar");

  let menuOpen = false;

  const setMenu = (open: boolean) => {
    menuOpen = open;
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("overflow-hidden", open);

    if (open) {
      // Con el menú abierto el header va sin fondo, para que el ícono blanco se vea
      navbar?.setAttribute("data-scrolled", "false");
      menu?.classList.replace("hidden", "flex");
      void menu?.offsetHeight;
      menu?.classList.remove("opacity-0", "-translate-y-4");
    } else {
      menu?.classList.add("opacity-0", "-translate-y-4");
      menu?.addEventListener(
        "transitionend",
        () => menu?.classList.replace("flex", "hidden"),
        { once: true }
      );
      updateNavbar();
    }
  };

  toggle?.addEventListener("click", () => setMenu(menu?.classList.contains("hidden") ?? false));

  const replayNavFade = (target: HTMLElement) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const items = [...target.querySelectorAll<HTMLElement>("[data-nav-fade]")];
    if (target.matches("[data-nav-fade]")) items.unshift(target);

    (items.length ? items : [target]).forEach((item, index) => {
      animate(item, { opacity: [0, 1], y: [20, 0] }, {
        duration: 0.65,
        delay: index * 0.06,
        ease: [0.22, 1, 0.36, 1],
      });
    });
  };

  // Los enlaces internos usan scroll de Motion cuando ya estamos en esa página.
  let anchorAnimation: { stop: () => void } | undefined;
  let anchorAnimationId = 0;
  const cancelAnchorAnimation = () => {
    if (!anchorAnimation) return;
    anchorAnimationId += 1;
    anchorAnimation.stop();
    anchorAnimation = undefined;
    window.dispatchEvent(new Event("motion:anchor-scroll-end"));
  };

  window.addEventListener("wheel", cancelAnchorAnimation, { passive: true });
  window.addEventListener("touchstart", cancelAnchorAnimation, { passive: true });
  window.addEventListener("keydown", (event) => {
    if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "].includes(event.key)) {
      cancelAnchorAnimation();
    }
  });

  document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
    link.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        (link.target && link.target !== "_self")
      ) {
        return;
      }

      setMenu(false);

      const url = new URL(link.href, window.location.href);
      if (url.origin !== window.location.origin || url.pathname !== window.location.pathname) {
        return;
      }

      const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
      if (!target) return;

      event.preventDefault();
      cancelAnchorAnimation();
      const currentAnimationId = ++anchorAnimationId;

      const targetY = Math.max(
        0,
        window.scrollY + target.getBoundingClientRect().top - (navbar?.offsetHeight ?? 0),
      );

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        window.scrollTo(0, targetY);
      } else {
        window.dispatchEvent(new Event("motion:anchor-scroll-start"));
        anchorAnimation = animate(window.scrollY, targetY, {
          duration: 0.95,
          ease: [0.22, 1, 0.36, 1],
          onUpdate: (nextY) => window.scrollTo(0, nextY),
        });
        void anchorAnimation.then(() => {
          if (currentAnimationId === anchorAnimationId) {
            anchorAnimation = undefined;
            window.dispatchEvent(new Event("motion:anchor-scroll-end"));
            replayNavFade(target);
          }
        });
      }

      window.history.pushState({}, "", `${url.pathname}${url.search}${url.hash}`);
    });
  });

  // Fondo con blur: en el index cuando termina el hero; en páginas claras al bajar un poco
  const hero = document.getElementById("inicio") ?? document.getElementById("hero-scroll");
  const isLight = navbar?.dataset.light === "true";
  let lastY = window.scrollY;

  function updateNavbar() {
    if (menuOpen) return;

    const y = window.scrollY;
    navbar?.classList.toggle("-translate-y-full", y > lastY && y > 100);

    const passedHero = hero
      ? hero.getBoundingClientRect().bottom <= (navbar?.offsetHeight ?? 64)
      : y > 20;
    const scrolled = isLight ? y > 20 : passedHero;
    navbar?.setAttribute("data-scrolled", String(scrolled));

    lastY = y;
  }

  window.addEventListener("scroll", updateNavbar, { passive: true });
  updateNavbar();
</script>
