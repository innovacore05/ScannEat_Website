---
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
---

<div class="mx-auto grid max-w-5xl items-center gap-10 px-6 py-16 lg:grid-cols-[minmax(0,3fr)_minmax(280px,2fr)]">

  <!-- Formulario -->
  <div class="w-full rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">

    <div class="mb-8">
      <h2 class="text-2xl font-semibold text-gray-950">
        Enviá un mensaje
      </h2>

      <p class="mt-2 text-sm leading-6 text-gray-600">
        Completá el formulario y nuestro equipo se pondrá en contacto con vos.
      </p>
    </div>

    <form
      action={`mailto:${contactEmail}`}
      method="post"
      enctype="text/plain"
      class="space-y-6"
    >

      <!-- Nombre -->
      <div>
        <label
          for="contact-name"
          class="mb-2 block text-sm font-medium text-gray-900"
        >
          Nombre
        </label>

        <input
          id="contact-name"
          name="Nombre"
          type="text"
          required
          autocomplete="name"
          placeholder="Tu nombre"
          class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-950 focus:ring-2 focus:ring-gray-950/10"
        />
      </div>

      <!-- Correo -->
      <div>
        <label
          for="contact-email"
          class="mb-2 block text-sm font-medium text-gray-900"
        >
          Correo electrónico
        </label>

        <input
          id="contact-email"
          name="Correo"
          type="email"
          required
          autocomplete="email"
          placeholder="tunombre@ejemplo.com"
          class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-950 focus:ring-2 focus:ring-gray-950/10"
        />
      </div>

      <!-- Asunto -->
      <div>
        <label
          for="contact-subject"
          class="mb-2 block text-sm font-medium text-gray-900"
        >
          Asunto
        </label>

        <input
          id="contact-subject"
          name="Asunto"
          type="text"
          required
          placeholder="¿En qué podemos ayudarte?"
          class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-950 focus:ring-2 focus:ring-gray-950/10"
        />
      </div>

      <!-- Mensaje -->
      <div>
        <label
          for="contact-message"
          class="mb-2 block text-sm font-medium text-gray-900"
        >
          Mensaje
        </label>

        <textarea
          id="contact-message"
          name="Mensaje"
          rows="6"
          required
          placeholder="Escribí tu mensaje..."
          class="w-full resize-none rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-950 focus:ring-2 focus:ring-gray-950/10"
        ></textarea>
      </div>

      <!-- Boton -->
      <button
        type="submit"
        class="w-full rounded-xl bg-gray-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-gray-800"
      >
        Enviar mensaje
      </button>

    </form>
  </div>

  <!-- Mascota 3D -->
 <div class="w-full lg:w-175">
  <model-viewer
  src="/innovacorecori.glb"
  alt="Mascota 3D de Innovacore"
  camera-controls
  auto-rotate
  shadow-intensity="1"
  environment-image="neutral"
  tone-mapping="neutral"
  camera-orbit="0deg 75deg 1.3m"
  field-of-view="25deg"
  style="width: 100%; height: 600px;"
></model-viewer>
</div>

</div>

<script>
  if (typeof window !== "undefined") {
    import("@google/model-viewer");
  }
</script>