---
import { Icon } from "astro-icon/components";
import Terms from "./Terms.astro";
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;

const facebookUrl = import.meta.env.PUBLIC_URL_FACEBOOK;
const instagramUrl = import.meta.env.PUBLIC_URL_INSTAGRAM;
const tiktokUrl = import.meta.env.PUBLIC_URL_TIKTOK;

---

<footer
  class="mt-auto border-t border-gray-300 bg-white px-6 py-16 text-gray-950 sm:px-10 md:px-16 md:py-20 lg:px-40"
>

   <!-- contenido principal -->
<div class="grid gap-y-12 md:grid-cols-[1.5fr_0.7fr_0.7fr_0.7fr] md:gap-x-8">

  <!-- marca de scan n eat -->
<div class="max-w-xs">

  <img src="/logoscaneat-color.svg" 
 alt="ScannEat" 
 class="mt-3 h-20 w-auto" /> 

  <p class="mt-3 text-sm leading-6 text-gray-700">
    Una solución sencilla para restaurantes y sus clientes. 
    Gestioná pedidos de forma rápida, clara y eficiente.
  </p>



<!-- Redes sociales -->


<div>


<div class="mt-4 flex gap-3">
<!-- Facebook -->
 <a 
 href={facebookUrl}
 target="_blank"
 rel="noopener noreferrer"
 aria-label="Facebook"
 class="flex h-10 w-10 items-center justify-center rounded-full transition-all hover:scale-110 hover:bg-gray-100">
   <Icon
            name="simple-icons:facebook"
            class="h-5 w-5"
            aria-hidden="true"
          />
 </a>
<!-- Insta -->
  <a
   href={instagramUrl}
 target="_blank"
 rel="noopener noreferrer"
 aria-label="Instagram"
  class="flex h-10 w-10 items-center justify-center rounded-full transition-all hover:scale-110 hover:bg-gray-100">
    <Icon
   name="simple-icons:instagram"
            class="h-5 w-5"
            aria-hidden="true"
  />
 </a>
 <!-- Tiktok -->
  <a 
  href={tiktokUrl}
 target="_blank"
 rel="noopener noreferrer"
 aria-label="Tiktok"
  class="flex h-10 w-10 items-center justify-center rounded-full transition-all hover:scale-110 hover:bg-gray-100">
    <Icon
   name="simple-icons:tiktok"
            class="h-5 w-5"
            aria-hidden="true"
  />
 </a>
</div>
<p class="mt-4 text-sm text-gray-700"> 
  Seguinos para conocer más sobre Scan n' Eat. 
</p>
</div>
<!-- ------------------------------ -->

<!-- ------------ -->
<div></div>




</div>
<!-- INFORMACION WEB -->


<!-- Producto -->
    <div class="md:pt-8">
      <h3 class="text-sm font-semibold uppercase tracking-wider">
        Producto
      </h3>

      <ul class="mt-4 space-y-3 text-sm text-gray-700">
        <li>
          <a
            href="/product#funcionalidades"
            class="transition-colors hover:text-gray-950"
          >
            Funcionalidades
          </a>
        </li>

        <li>
          <a
            href="/product#como-funciona"
            class="transition-colors hover:text-gray-950"
          >
            Cómo funciona
          </a>
        </li>
      </ul>
    </div>


    <!-- Empresa -->
   <div class="md:pt-8">
      <h3 class="text-sm font-semibold uppercase tracking-wider">
        Empresa
      </h3>

      <ul class="mt-4 space-y-3 text-sm text-gray-700">
        <li>
          <a
            href="/aboutUs#innovacore"
            class="transition-colors hover:text-gray-950"
          >
            Innovacore
          </a>
        </li>

        <li>
          <a
            href="/aboutUs#nosotros"
            class="transition-colors hover:text-gray-950"
          >
            Sobre nosotros
          </a>
        </li>
      </ul>
    </div>


    <!-- Legal -->
    <div class="md:pt-8">
      <h3 class="text-sm font-semibold uppercase tracking-wider">
        Legal
      </h3>

      <ul class="mt-4 space-y-3 text-sm text-gray-700">
        <li>
          <button
            id="open-terms"
            type="button"
            class="transition-colors hover:text-gray-950 cursor-pointer"
          >
            Términos y condiciones
          </button>
        </li>

        
      </ul>
    </div>

  </div>


  <!-- ----------------------------->
  <div class="my-12 border-t border-gray-300"></div>


  <!-- Firma Innovacore -->
  <div class="flex flex-col items-center text-center">

    <p class="text-sm text-gray-950">
      Desarrollado por
    </p>

    <img
      src="/logo-innovacore-black.svg"
      alt="Innovacore"
      class="mt-3 h-8 w-auto"
    />

    <p class="mt-5 text-xs text-gray-500">
      © {new Date().getFullYear()} Innovacore. Todos los derechos reservados.
    </p>

    <p class="mt-2 text-xs text-gray-500">
      Costa Rica
    </p>

  </div>


  <Terms />
</footer>