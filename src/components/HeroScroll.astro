---
// Cambia estas rutas por tus archivos en /public
const heroVideo = "/menutradicional.mp4";
const heroPoster = "/hero-poster.jpg";
const phoneVideo = "/telefonomenu.mp4";
---

<section id="hero-scroll" class="relative h-[320vh]">
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black">

    <!-- Video de fondo: queda detrás y se blurrea al encogerse el video grande -->
    <video
      class="absolute inset-0 size-full scale-110 object-cover will-change-[filter]"
      style="filter: blur(calc(var(--s, 0) * 14px))"
      src={heroVideo}
      poster={heroPoster}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>

    <!-- Capa oscura del fondo -->
    <div
      class="absolute inset-0 bg-black"
      style="opacity: calc(0.25 + var(--s, 0) * 0.35)"
    ></div>

    <!-- Video de papel: empieza a pantalla completa y se encoge hasta el celular -->
    <div
      id="phone-frame"
      class="pointer-events-none absolute left-0 top-0 overflow-hidden border-solid border-neutral-900 bg-neutral-900 shadow-2xl"
      style="width: 100%; height: 100%"
    >
      <video
        class="absolute inset-0 size-full object-cover"
        src={heroVideo}
        poster={heroPoster}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      ></video>

      <!-- Capa oscura propia: se aclara al encogerse -->
      <div id="shade" class="absolute inset-0 bg-black" style="opacity: 0.25"></div>

      <!-- Video del menú digital: sube desde abajo dentro del celular -->
      <video
        id="phone-video"
        class="absolute inset-0 size-full object-cover"
        style="transform: translateY(100%)"
        src={phoneVideo}
        autoplay
        muted
        loop
        playsinline
      ></video>

      <!-- notch -->
      <div
        id="notch"
        class="absolute left-1/2 top-2 h-5 w-24 -translate-x-1/2 rounded-full bg-neutral-900"
        style="opacity: 0"
      ></div>
    </div>

    <!-- Texto 1: se desvanece al empezar el scroll -->
    <div
      class="pointer-events-none absolute inset-0 flex items-center px-6 sm:px-10"
      style="opacity: var(--text, 1); transform: translateY(calc((1 - var(--text, 1)) * -40px))"
    >
      <div class="mx-auto w-full max-w-7xl">
        <h1 class="max-w-2xl text-5xl font-bold tracking-tight text-white sm:text-7xl">
          ¿Todavía tu menú es de papel?
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/90">
          Tus clientes ya viven en el celular. Tu menú también debería.
        </p>
      </div>
    </div>

    <!-- Texto 2: aparece mientras el video se encoge al celular -->
    <div
      class="pointer-events-none absolute inset-0 hidden items-center px-6 sm:px-10 lg:flex"
      style="opacity: var(--s, 0); transform: translateY(calc((1 - var(--s, 0)) * 40px))"
    >
      <div class="mx-auto w-full max-w-7xl">
        <h2 class="max-w-md text-4xl font-bold tracking-tight text-white sm:text-5xl">
          ¿Y si pedir fuera así de fácil?
        </h2>
        <p class="mt-4 max-w-md text-lg text-white/90">
          Tus clientes escanean el QR, ven el menú al instante y envían su orden.
        </p>
      </div>
    </div>

    <!-- Hueco donde termina el celular (solo mide la posición, no se ve) -->
    <div class="pointer-events-none absolute inset-0 flex items-end justify-center px-6 pb-[10vh] sm:px-10 lg:justify-end">
      <div class="mx-auto flex w-full max-w-7xl items-end justify-center lg:justify-end">
        <div id="phone-slot" class="aspect-[9/19] h-[70vh]"></div>
      </div>
    </div>

  </div>
</section>

<script>
  const section = document.getElementById("hero-scroll");
  const sticky = section?.firstElementChild as HTMLElement | null;
  const frame = document.getElementById("phone-frame");
  const slot = document.getElementById("phone-slot");
  const notch = document.getElementById("notch");
  const shade = document.getElementById("shade");
  const phoneVideo = document.getElementById("phone-video");

  const clamp = (n: number) => Math.min(1, Math.max(0, n));
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  let current = 0;
let targetP = 0;

const readTarget = () => {
  if (!section) return;
  const total = section.offsetHeight - window.innerHeight;
  targetP = clamp(-section.getBoundingClientRect().top / total);
};

const render = (p: number) => {
  if (!section || !sticky || !frame || !slot) return;

    section.style.setProperty("--p", p.toFixed(3));
    section.style.setProperty("--text", (1 - clamp(p / 0.2)).toFixed(3));

    // Fase 1: el video de papel se encoge hasta el celular (10% a 60%)
    const s = ease(clamp((p - 0.1) / 0.5));
    section.style.setProperty("--s", s.toFixed(3));

    // Fase 2: con más scroll, el video del menú digital sube dentro del celular (60% a 95%)
    const rise = ease(clamp((p - 0.6) / 0.35));

    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const r = slot.getBoundingClientRect();
    const base = sticky.getBoundingClientRect();

    frame.style.left = `${lerp(0, r.left - base.left, s)}px`;
    frame.style.top = `${lerp(0, r.top - base.top, s)}px`;
    frame.style.width = `${lerp(vw, r.width, s)}px`;
    frame.style.height = `${lerp(vh, r.height, s)}px`;
    frame.style.borderWidth = `${10 * s}px`;
    frame.style.borderRadius = `${40 * s}px`;

    if (shade) shade.style.opacity = (0.25 * (1 - s)).toFixed(3);
    if (phoneVideo) phoneVideo.style.transform = `translateY(${(1 - rise) * 100}%)`;
    if (notch) notch.style.opacity = s.toFixed(3);
  };

 // Puntos de reposo (progreso 0 a 1): inicio, celular listo, video subido
// Puntos de reposo (progreso 0 a 1): inicio, celular listo, video subido
const stops = [0, 0.6, 1];

// Curva con rebote: se pasa un poquito y regresa (sube c para más "boing")
const easeOutBack = (t: number) => {
  const c1 = 1.4;
  const c3 = c1 + 1;
  return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
};

let lastY = window.scrollY;
let dir = 1;
let timer: number | undefined;
let animating = false;
let raf = 0;

const animateTo = (target: number, duration = 1100) => {
  const from = window.scrollY;
  const start = performance.now();
  animating = true;
  cancelAnimationFrame(raf);

  const step = (now: number) => {
    const t = clamp((now - start) / duration);
    window.scrollTo(0, from + (target - from) * easeOutBack(t));
    if (t < 1) {
      raf = requestAnimationFrame(step);
    } else {
      animating = false;
      lastY = window.scrollY;
    }
  };
  raf = requestAnimationFrame(step);
};

// Si el usuario vuelve a mover el scroll, se cancela la animación
const cancel = () => {
  if (!animating) return;
  cancelAnimationFrame(raf);
  animating = false;
};
window.addEventListener("wheel", cancel, { passive: true });
window.addEventListener("touchstart", cancel, { passive: true });
window.addEventListener("keydown", cancel);

const snap = () => {
  if (!section || animating) return;
  const total = section.offsetHeight - window.innerHeight;
  const top = window.scrollY + section.getBoundingClientRect().top;
  const p = (window.scrollY - top) / total;

  if (p <= 0 || p >= 1) return;

  const target =
    dir > 0
      ? stops.find((s) => s > p + 0.01)
      : [...stops].reverse().find((s) => s < p - 0.01);

  if (target === undefined) return;
  animateTo(top + target * total);
};

window.addEventListener(
  "scroll",
  () => {
    readTarget();;
    if (animating) return;

    const y = window.scrollY;
    if (y !== lastY) dir = y > lastY ? 1 : -1;
    lastY = y;

    window.clearTimeout(timer);
    timer = window.setTimeout(snap, 120);
  },
  { passive: true }
);
window.addEventListener("resize", readTarget);

// Loop: el progreso visible persigue al progreso real del scroll
const loop = () => {
  current += (targetP - current) * 0.1;
  if (Math.abs(targetP - current) < 0.0005) current = targetP;
  render(current);
  requestAnimationFrame(loop);
};

readTarget();
current = targetP;
loop();
</script>