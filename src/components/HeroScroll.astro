---
// Cambia estas rutas por tus archivos en /public
const heroVideoMp4 = "/menutradicional-optimized.mp4";
const heroVideoWebm = "/menutradicional-optimized.webm";
const heroPoster = "/hero-poster.webp";
const phoneVideoMp4 = "/telefonomenu-optimized.mp4";
const phoneVideoWebm = "/telefonomenu-optimized.webm";

---

<section id="inicio" class="relative h-[320vh]">
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black">

    <!-- Video de fondo: queda detrás y se blurrea al encogerse el video grande -->
    <video
      class="absolute inset-0 size-full scale-110 object-cover will-change-[filter]"
      style="filter: blur(calc(var(--s, 0) * 14px))"
      poster={heroPoster}
      muted
      loop
      playsinline
      preload="none"
      data-lazy-video="background"
    >
      <source src={heroVideoWebm} type="video/webm" />
      <source src={heroVideoMp4} type="video/mp4" />
    </video>

    <!-- Capa oscura del fondo -->
    <div
      class="absolute inset-0 bg-black"
      style="opacity: calc(0.25 + var(--s, 0) * 0.35)"
    ></div>

    <!-- Video de papel: empieza a pantalla completa y se encoge hasta el celular -->
    <div
      id="phone-frame"
      class="pointer-events-none absolute left-0 top-0 origin-top-left overflow-hidden border-solid border-neutral-900 bg-neutral-900 shadow-2xl will-change-transform"
      style="width: 100%; height: 100%"
    >
      <video
        class="absolute inset-0 size-full object-cover"
        poster={heroPoster}
        muted
        loop
        playsinline
        preload="none"
        data-lazy-video="foreground"
      >
        <source src={heroVideoWebm} type="video/webm" />
        <source src={heroVideoMp4} type="video/mp4" />
      </video>

      <!-- Capa oscura propia: se aclara al encogerse -->
      <div id="shade" class="absolute inset-0 bg-black" style="opacity: 0.25"></div>

    </div>

    <!-- Texto 1: se desvanece al empezar el scroll -->
    <div
      class="pointer-events-none absolute inset-0 flex items-center px-6 sm:px-10"
      style="opacity: var(--text, 1); transform: translateY(calc((1 - var(--text, 1)) * -40px))"
    >
      <div class="mx-auto w-full max-w-7xl">
        <h1 class="max-w-2xl text-5xl font-bold tracking-tight text-white sm:text-7xl">
          ¿Todavía tu menú es de papel?
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/90">
          Tus clientes ya viven en el celular. Tu menú también debería.
        </p>
      </div>
    </div>

    <!-- Texto 2: aparece mientras el video se encoge al celular -->
    <div
      class="pointer-events-none absolute inset-0 hidden items-center px-6 sm:px-10 lg:flex"
      style="opacity: var(--s, 0); transform: translateY(calc((1 - var(--s, 0)) * 40px))"
    >
      <div class="mx-auto w-full max-w-7xl">
        <h2 class="max-w-md text-4xl font-bold tracking-tight text-white sm:text-5xl">
          ¿Y si pedir fuera así de fácil?
        </h2>
        <p class="mt-4 max-w-md text-lg text-white/90">
          Tus clientes escanean el QR, ven el menú al instante y envían su orden.
        </p>
      </div>
    </div>

    <!-- Hueco donde termina el celular (solo mide la posición, no se ve) -->
    <div class="pointer-events-none absolute inset-0 flex items-end justify-center px-6 pb-[10vh] sm:px-10 lg:justify-end">
      <div class="mx-auto flex w-full max-w-7xl items-end justify-center lg:justify-end">
        <div id="phone-slot" class="relative z-10 isolate aspect-[9/19] h-[70vh] overflow-hidden rounded-[40px]" style="opacity: 0">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-[40px] border-[10px] border-neutral-900"></div>
          <div class="absolute inset-[10px] z-10 overflow-hidden rounded-[28px]">
            <video
              id="phone-video"
              class="absolute inset-0 size-full origin-center object-cover"
              style="transform: translateY(100%)"
              muted
              loop
              playsinline
              preload="none"
              data-lazy-video="phone"
            >
              <source src={phoneVideoMp4} type="video/mp4" />
              <source src={phoneVideoWebm} type="video/webm" />
            </video>
          </div>
          <div
            id="notch"
            class="absolute left-1/2 top-2 z-30 h-5 w-24 -translate-x-1/2 rounded-full bg-neutral-900"
            style="opacity: 0"
          ></div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { animate, scroll } from "motion";

  const section = document.getElementById("inicio");
  const sticky = section?.firstElementChild as HTMLElement | null;
  const frame = document.getElementById("phone-frame");
  const slot = document.getElementById("phone-slot");
  const notch = document.getElementById("notch");
  const shade = document.getElementById("shade");
  const phoneVideo = document.getElementById("phone-video") as HTMLVideoElement | null;
  const backgroundVideo = section?.querySelector<HTMLVideoElement>('[data-lazy-video="background"]') ?? null;
  const foregroundVideo = section?.querySelector<HTMLVideoElement>('[data-lazy-video="foreground"]') ?? null;
  let phoneVideoPrepared = false;

  const setVideoPlaying = (video: HTMLVideoElement | null, shouldPlay: boolean) => {
    if (!video) return;
    if (shouldPlay && video.paused) void video.play().catch(() => {});
    if (!shouldPlay && !video.paused) video.pause();
  };

  const preparePhoneVideo = () => {
    if (!phoneVideo || phoneVideoPrepared) return;
    phoneVideoPrepared = true;
    phoneVideo.preload = "auto";
    phoneVideo.load();
  };

  const clamp = (n: number) => Math.min(1, Math.max(0, n));
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let progress = 0;
  let slotGeometry: { left: number; top: number; width: number; height: number } | null = null;

const render = (p: number) => {
  if (!section || !frame || !slotGeometry) return;
  progress = p;

    section.style.setProperty("--p", p.toFixed(3));
    section.style.setProperty("--text", (1 - clamp(p / 0.2)).toFixed(3));

    // Fase 1: el video de papel se encoge hasta el celular (10% a 60%)
    const s = ease(clamp((p - 0.1) / 0.5));
    section.style.setProperty("--s", s.toFixed(3));

    // Fase 2: con más scroll, el video del menú digital sube dentro del celular (60% a 95%)
    const phonePhaseStart = 0.6;
    const rise = ease(clamp((p - phonePhaseStart) / 0.35));

    // Precarga mientras el marco se acerca; el video no espera a empezar a subir.
    if (s > 0.65) preparePhoneVideo();

    setVideoPlaying(backgroundVideo, s > 0.02);
    setVideoPlaying(phoneVideo, rise > 0.02);

    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const scaleX = lerp(1, slotGeometry.width / vw, s);
    const scaleY = lerp(1, slotGeometry.height / vh, s);
    const cornerRadius = 40 * s;

    frame.style.transform =
      `translate3d(${slotGeometry.left * s}px, ${slotGeometry.top * s}px, 0) scale(${scaleX}, ${scaleY})`;
    frame.style.borderRadius = `${cornerRadius / scaleX}px / ${cornerRadius / scaleY}px`;
    frame.style.boxShadow =
      `inset 0 0 0 ${10 * s}px #171717, 0 25px 50px -12px rgb(0 0 0 / 0.25)`;

    // Compensa la escala desigual del marco para conservar la proporción del video.
    const coverScale = Math.max(scaleX, scaleY);
    if (foregroundVideo) {
      foregroundVideo.style.transform =
        `scale(${coverScale / scaleX}, ${coverScale / scaleY})`;
    }

    if (shade) shade.style.opacity = (0.25 * (1 - s)).toFixed(3);
    // Muestra el bisel cuando el marco casi llegó al teléfono, con margen para el redondeo del scroll.
    if (slot) slot.style.opacity = s >= 0.9999 ? "1" : "0";
    if (phoneVideo) phoneVideo.style.transform = `translateY(${(1 - rise) * 100}%)`;
    if (notch) notch.style.opacity = s.toFixed(3);
  };

  const measureSlot = () => {
    if (!sticky || !slot) return;

    if (frame) {
      frame.style.width = `${window.innerWidth}px`;
      frame.style.height = `${window.innerHeight}px`;
    }

    const slotRect = slot.getBoundingClientRect();
    const stickyRect = sticky.getBoundingClientRect();

    slotGeometry = {
      left: slotRect.left - stickyRect.left,
      top: slotRect.top - stickyRect.top,
      width: slotRect.width,
      height: slotRect.height,
    };

    render(progress);
  };

  measureSlot();
  window.addEventListener("resize", measureSlot);

  if (prefersReducedMotion) {
    if (section) section.style.height = "100vh";
    render(0);
  } else if (section) {
    setVideoPlaying(foregroundVideo, true);
    scroll((nextProgress) => render(nextProgress), {
      target: section,
      offset: ["start start", "end end"],
    });
    render(0);
  }

 // Puntos de reposo (progreso 0 a 1): inicio, celular listo, video subido
// Puntos de reposo (progreso 0 a 1): inicio, celular listo, video subido
const stops = [0, 0.6, 1];

// Conserva el movimiento visual original del hero y añade un rebote leve al final.
const easeOutBack = (t: number) => {
  const c1 = 1.4;
  const c3 = c1 + 1;
  return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
};

let lastY = window.scrollY;
let dir = 1;
let timer: number | undefined;
let animating = false;
let anchorScrolling = false;
let lastInput: "wheel" | "touch" | "keyboard" = "wheel";
let snapAnimation: { stop: () => void } | undefined;
let snapAnimationId = 0;

const animateTo = (target: number, durationMs: number) => {
  const from = window.scrollY;
  const animationId = ++snapAnimationId;
  animating = true;
  snapAnimation?.stop();

  const animation = animate(from, target, {
    duration: durationMs / 1000,
    ease: easeOutBack,
    onUpdate: (nextY) => window.scrollTo(0, nextY),
  });

  snapAnimation = animation;
  void animation.then(() => {
    if (animationId !== snapAnimationId) return;
    animating = false;
    lastY = window.scrollY;
  });
};

// Si el usuario vuelve a mover el scroll, se cancela la animación
const cancel = () => {
  if (!animating) return;
  snapAnimationId += 1;
  snapAnimation?.stop();
  animating = false;
};
window.addEventListener("wheel", () => {
  lastInput = "wheel";
  cancel();
}, { passive: true });
window.addEventListener("touchstart", () => {
  lastInput = "touch";
  cancel();
}, { passive: true });
window.addEventListener("keydown", () => {
  lastInput = "keyboard";
  cancel();
});

window.addEventListener("motion:anchor-scroll-start", () => {
  anchorScrolling = true;
  window.clearTimeout(timer);
  cancel();
});
window.addEventListener("motion:anchor-scroll-end", () => {
  anchorScrolling = false;
  lastY = window.scrollY;
});

const snap = () => {
  if (!section || animating || prefersReducedMotion) return;
  const total = section.offsetHeight - window.innerHeight;
  const top = window.scrollY + section.getBoundingClientRect().top;
  const p = (window.scrollY - top) / total;

  if (p <= 0 || p >= 1) return;

  const target =
    dir > 0
      ? stops.find((s) => s > p + 0.01)
      : [...stops].reverse().find((s) => s < p - 0.01);

  if (target === undefined) return;
  const duration = lastInput === "touch" ? 700 : 1100;
  animateTo(top + target * total, duration);
};

window.addEventListener(
  "scroll",
  () => {
    if (animating || anchorScrolling) {
      lastY = window.scrollY;
      return;
    }

    const y = window.scrollY;
    if (y !== lastY) dir = y > lastY ? 1 : -1;
    lastY = y;

    window.clearTimeout(timer);
    timer = window.setTimeout(snap, lastInput === "wheel" ? 45 : 120);
  },
  { passive: true }
);
</script>
