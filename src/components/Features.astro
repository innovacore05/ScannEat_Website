---
type FeatureCard = {
  title: string;
  description: string;
  image: string;
  alt: string;
};

type GuideStep = {
  number: number;
  title: string;
  description: string;
};

const features: FeatureCard[] = [
  {
    title: "Pedidos directo desde la mesa",
    description:
      "El cliente escanea el QR, ve el menú y confirma su pedido.",
    image: "qr.webp",
    alt: "Cliente escaneando el código QR de la mesa",
  },
  {
    title: "Recomendaciones con IA",
    description:
      "Un chatbot sugiere platillos según el presupuesto del cliente.",
    image: "ia.webp",
    alt: "Chat con recomendaciones de platillos",
  },
  {
    title: "Facturación integrada",
    description:
      "Generá la factura del pedido directamente desde el sistema.",
    image: "facturacion.webp",
    alt: "Factura electrónica generada en pantalla",
  },
  {
    title: "Panel de administración inteligente",
    description:
      "Consultá reportes y recibí insights automáticos para tomar mejores decisiones.",
    image: "panel-card.webp",
    alt: "Panel de administración con reportes de ventas",
  },
  {
    title: "Menú siempre actualizado",
    description: "Cambiá precios y platillos al instante, sin reimprimir nada.",
    image: "menu-card.webp",
    alt: "Editor del menú digital",
  },
  {
    title: "Pedidos en cocina al instante",
    description: "Cada orden llega directo a cocina y meseros, sin papelitos.",
    image: "cocina-card.webp",
    alt: "Pantalla de cocina con pedidos entrantes",
  },
  {
  title: "Agilidad de mesero",
  description: "Comandas al instante en cocina",
  image: "mesero-card.webp",
  alt: "Mesero y pedido",
},
];

// Cómo funciona
const guideSteps: GuideStep[] = [
  {
    number: 1,
    title: "Creá tus mesas",
    description:
      "Registrá las mesas de tu restaurante en el sistema, con su número y capacidad.",
  },
  {
    number: 2,
    title: "Descargá tu QR",
    description:
      "Generá un código QR único por mesa, listo para imprimir y colocar.",
  },
  {
    number: 3,
    title: "Dejá que tus clientes pidan",
    description:
      "Escanean el QR, ven el menú y hacen su pedido, que llega directo a cocina y meseros.",
  },
  {
    number: 4,
    title: "Cerrá la cuenta y facturá",
    description:
      "Cerrá la cuenta, generá la factura y consultá la información de tus ventas del día o del mes.",
  },
];
---

<section
  id="funcionalidades"
  aria-labelledby="features-heading"
  class="relative h-[200vh] scroll-mt-16"
>
  <div class="sticky top-0 flex h-screen flex-col items-center justify-center overflow-hidden px-6 pt-16 text-center">
    <h2 id="features-heading" class="text-3xl font-bold sm:text-5xl" data-nav-fade>Funcionalidades</h2>
    <p class="mt-2 text-gray-600" data-nav-fade>Todo lo que necesitás para agilizar tu negocio</p>

    <div
      id="cards"
      class="relative mt-6 grid w-full max-w-7xl grid-cols-2 gap-3 lg:grid-cols-12 lg:gap-4"
      data-nav-fade
    >
      {features.map(({ title, description, image, alt }, i) => (
        <article
          data-card
          class:list={[
            "group relative h-[17vh] min-h-[100px] overflow-hidden rounded-2xl bg-gradient-to-br from-brand-mint to-brand-mint-dark text-left shadow-lg will-change-transform lg:h-[30vh] lg:min-h-[190px]",
            i < 4 ? "lg:col-span-3" : "lg:col-span-4",
            i === features.length - 1 && "col-span-2",
          ]}
        >
          <!-- Foto a card completa: si no existe, queda el degradado de fondo -->
          <img
            src={image}
            alt={alt}
            loading="lazy"
            class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
            onerror="this.style.display='none'"
          />

          <!-- Degradado para que el texto se lea sobre cualquier foto -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent transition-opacity duration-300 group-hover:from-brand-mint-dark/90"></div>

          <!-- Texto abajo -->
          <div class="absolute inset-x-0 bottom-0 flex flex-col gap-1 p-3 text-white sm:gap-2 sm:p-5">
            <h3 class="text-sm font-semibold leading-tight sm:text-lg">{title}</h3>
            <p class="hidden text-sm leading-snug text-white/85 lg:block">{description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section
  id="como-funciona"
  aria-labelledby="owner-guide-heading"
  class="mx-auto max-w-6xl scroll-mt-16 px-6 py-24"
>
  <div class="mx-auto max-w-2xl text-center" data-scroll-fade data-nav-fade>
    <h2
      id="owner-guide-heading"
      class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
    >
      Cómo usar Scan n' Eat en tu restaurante
    </h2>

    <p class="mt-4 text-lg text-gray-600">
      De la mesa a la caja, todo tu equipo conectado en un solo sistema.
    </p>
  </div>

  <!-- pasos -->
  <ol class="mt-16 grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    {guideSteps.map(({ number, title, description }) => (
      <li class="group flex flex-col gap-3 text-center sm:text-left" data-scroll-fade data-nav-fade>
        <span class="text-7xl font-extrabold leading-none text-brand-mint/30 transition-colors duration-300 group-hover:text-brand-mint-dark">
          {String(number).padStart(2, "0")}
        </span>
        <h3 class="text-xl font-semibold text-gray-900">{title}</h3>
        <p class="text-base leading-7 text-gray-600">{description}</p>
      </li>
    ))}
  </ol>
</section>

<script>
  import { scroll } from "motion";

  const box = document.getElementById("cards");
  const section = box?.closest<HTMLElement>("section") ?? null;
  const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];

  const clamp = (n: number) => Math.min(1, Math.max(0, n));
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const startRot = [0, 7, -6, 10, -8, 5, -4]; // la primera queda derecha, las de atrás asoman torcidas

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let progress = 0;
  let cardPositions: { dx: number; dy: number }[] = [];

  const render = (p: number) => {
    if (!box) return;
    progress = p;
    // Se despliegan a lo largo de todo el recorrido fijado de la sección.
    const t = ease(clamp(p));

    cards.forEach((c, i) => {
      const position = cardPositions[i];
      if (!position) return;
      const k = 1 - t;

      c.style.zIndex = String(cards.length - i);
      c.style.transform =
        `translate(${position.dx * k}px, ${position.dy * k}px) rotate(${startRot[i % startRot.length] * k}deg) scale(${0.85 + 0.15 * t})`;
    });
  };

  const measureCards = () => {
    if (!box) return;

    const cx = box.clientWidth / 2;
    const cy = box.clientHeight / 2;

    cardPositions = cards.map((card) => ({
      dx: cx - (card.offsetLeft + card.offsetWidth / 2),
      dy: cy - (card.offsetTop + card.offsetHeight / 2),
    }));

    render(progress);
  };

  measureCards();
  window.addEventListener("resize", measureCards);

  if (prefersReducedMotion) {
    if (section) {
      section.style.height = "auto";

      const stickyContent = section.firstElementChild as HTMLElement | null;
      if (stickyContent) {
        stickyContent.style.position = "relative";
        stickyContent.style.height = "auto";
        stickyContent.style.minHeight = "100vh";
      }
    }
    render(1);
  } else if (section) {
    scroll((nextProgress) => render(nextProgress), {
      target: section,
      offset: ["start start", "end end"],
    });
    render(0);
  }
</script>
