---
import { QrCode, Sparkles, Receipt, LayoutDashboard, LayoutGrid, Users } from 'lucide-astro';

type FeatureCard = {
  icon: typeof QrCode;
  title: string;
  description: string;
};

type GuideStep = {
  number: number;
  title: string;
  description: string;
};
 
const features: FeatureCard[] = [
  {
    icon: QrCode,
    title: "Pedidos directo desde la mesa",
    description:
      "El cliente escanea el QR, ve el menú y confirma su pedido, sin esperar a que un mesero lo atienda.",
  },
  {
    icon: Sparkles,
    title: "Recomendaciones con IA",
    description: "Un chatbot sugiere platillos según el presupuesto y el tipo de comida que el cliente busca.",
  },
  {
    icon: Receipt,
    title: "Facturación integrada",
    description: "Generá la factura del pedido directamente desde el sistema, sin procesos manuales aparte.",
  },
  {
    icon: LayoutDashboard,
    title: "Panel de administración inteligente",
    description: "Consultá reportes, identificá tus platillos más vendidos y mejor calificados, y recibí insights automáticos para tomar mejores decisiones, todo desde un solo lugar.",
  },
];

//como funciona info
const guideSteps: GuideStep[] = [
  {
    number: 1,
    title: "Creá tus mesas",
    description: "Registrá las mesas de tu restaurante en el sistema, con su número y capacidad.",
  },
  {
    number: 2,
    title: "Descargá tu QR",
    description: "Generás un código QR único por mesa, listo para imprimir y colocar.",
  },
  {
    number: 3,
  title: "Dejá que tus clientes pidan",
    description: "Escanean el QR, ven el menú y hacen su pedido, que llega directo a cocina y meseros.",
  },
  {
  number: 4,
  title: "Cerrá la cuenta y facturá",
  description:
    "Cerrá la cuenta, generá la factura y consultá la información de tus ventas del día o del mes.",
},
];
---

<section id="funcionalidades" aria-labelledby="features-heading" class="mx-auto max-w-7xl px-6 py-16 text-center animate-fade-in-up scroll-mt-16">
  <div>
    <h2 id="features-heading" class="text-3xl font-bold">Funcionalidades</h2>
    <p class="mt-2 text-gray-600">Todo lo que necesitas para agilizar tu negocio</p>
  </div>

  <div class="mt-12 grid grid-cols-1 divide-y divide-gray-200 border border-gray-200 sm:grid-cols-2 sm:divide-x lg:grid-cols-4">
    {features.map(({ icon: Icon, title, description }) => (
      <article class="flex flex-col items-center gap-3 p-8 transition-colors duration-300 hover:bg-brand-mint hover:text-white">
        <Icon aria-hidden="true" class="h-8 w-8 text-brand-mint-darker" />
        <h3 class="font-semibold">{title}</h3>
        <p class="text-sm text-gray-600 ">{description}</p>
      </article>
    ))}
  </div>
</section>



<section
  id="como-funciona"
  aria-labelledby="owner-guide-heading"
  class="mx-auto max-w-5xl px-6 py-16 animate-fade-in-up scroll-mt-16"
>
  <div class="mx-auto max-w-2xl text-center">
    

   <h2
  id="owner-guide-heading"
  class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
>
  Cómo usar Scan n' Eat en tu restaurante
</h2>

<p class="mt-4 text-lg text-gray-600">
  De la mesa a la caja, todo tu equipo conectado en un solo sistema.
</p>
  </div>

     <!-- pasos renderizados -->
  <div class="mt-16 flex flex-col items-center gap-8">
    {guideSteps.map(({ number, title, description }) => (
      <article class="flex w-full max-w-lg flex-col gap-3 rounded-2xl border border-gray-200 p-6 text-center sm:p-8">
        <span class="text-sm font-bold text-brand-mint-dark">PASO {number}</span>
        <h3 class="text-xl font-semibold text-gray-900">{title}</h3>
        <p class="text-base leading-7 text-gray-600">{description}</p>
      </article>
    ))}
  </div>
</section>