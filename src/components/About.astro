---
export interface Props {}

const {} = Astro.props;

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const lauraLinkedin = import.meta.env.PUBLIC_URL_LAURA;
const brittanyLinkedin = import.meta.env.PUBLIC_URL_BRITTANY;
const alissonLinkedin = import.meta.env.PUBLIC_URL_ALISSON;
const johanLinkedin = import.meta.env.PUBLIC_URL_JOHAN;
const francinyLinkedin = import.meta.env.PUBLIC_URL_FRANCINY;

const team = [
  { name: "Brittany Garcia", role: "FULL STACK DEVELOPER", photo: "/brittany.webp", vcard: "https://vcard.ws/brittany-garcia" },
  { name: "Alisson Gomez", role: "FULL STACK DEVELOPER", photo: "/alisson.webp", vcard: "https://vcard.ws/alisson-gomez" },
  { name: "Johan Brenes", role: "FULL STACK DEVELOPER", photo: "/johan.webp", vcard: "https://vcard.ws/johan-brenes-vargas" },
  { name: "Franciny Bonilla", role: "FFULL STACK DEVELOPER", photo: "/franciny.webp", vcard: "https://vcard.ws/franciny-raquel-bonilla-ortiz" },
  { name: "Laura Arroyo", role: "FULL STACK DEVELOPER", photo: "/laura.webp", vcard: "https://vcard.ws/lear" },
];

const getInitials = (name: string) =>
  name
    .split(" ")
    .map((word) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<!-- SOBRE INNOVACORE -->
<section
  id="innovacore"
  class="bg-white py-16 sm:py-24"
  aria-labelledby="innovacore-heading"
>
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 sm:px-10 lg:grid-cols-[1fr_1fr]">

    <!-- Parrafo -->
    <div data-scroll-fade data-nav-fade>
      <img
        src="/logo-innovacore-black.svg"
        alt="Innovacore"
        class="mb-8 h-10 w-auto"
      />

      <span class="text-lg font-semibold text-brand-mint-dark">
        Sobre Innovacore
      </span>

      <h2
        id="innovacore-heading"
        class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
      >
        Creamos soluciones digitales con propósito.
      </h2>

      <p class="mt-6 text-lg leading-8 text-gray-600">
        Somos un equipo enfocado en desarrollar soluciones tecnológicas para
        necesidades reales, combinando creatividad, innovación y tecnología para
        crear experiencias útiles y funcionales. En Innovacore creemos que la
        tecnología debe facilitar procesos, mejorar experiencias y aportar valor
        a las personas y los negocios. Por eso, transformamos ideas y
        necesidades en proyectos digitales prácticos, accesibles y adaptados a
        diferentes contextos. Nuestro objetivo es conectar la tecnología con las
        necesidades del mundo real, creando soluciones que generen un impacto
        positivo.
      </p>

      <a
        href={`mailto:${contactEmail}`}
        class="mt-8 inline-flex items-center justify-center rounded-xl bg-brand-mint-dark px-6 py-3 text-base font-medium text-white shadow-sm transition hover:bg-brand-mint-darker"
        aria-label="Enviar correo a Innovacore"
      >
        Contáctanos
      </a>
    </div>

    <!-- Mascota 3D -->
    <div class="flex w-full justify-center lg:justify-end" data-scroll-fade data-nav-fade>
      <div class="w-full lg:w-125">
        <model-viewer
          data-model-src="/innovacorecori-lite.glb"
          alt="Mascota 3D de Innovacore"
          loading="lazy"
          camera-controls
          touch-action="pan-y"
          disable-zoom
          disable-pan
          shadow-intensity="1"
          environment-image="neutral"
          tone-mapping="neutral"
          camera-orbit="0deg 75deg 95%"
          min-camera-orbit="-180deg 75deg auto"
          max-camera-orbit="180deg 75deg auto"
          field-of-view="25deg"
          interaction-prompt="none"
          style="width: 100%; height: 600px; background: #f7f7f7;"></model-viewer>
      </div>
    </div>
  </div>
</section>

<script>
  const modelViewer = document.querySelector<HTMLElement>("model-viewer");

  if (modelViewer) {
    const modelObserver = new IntersectionObserver(async ([entry], observer) => {
      if (!entry?.isIntersecting) return;
      observer.disconnect();
      await import("@google/model-viewer");
      const modelSrc = modelViewer.dataset.modelSrc;
      if (modelSrc) modelViewer.setAttribute("src", modelSrc);
    }, { rootMargin: "200px" });

    modelObserver.observe(modelViewer);
  }
</script>

<!-- NUESTRO EQUIPO -->
<section id="nosotros" class="bg-white pb-16 sm:pb-24 scroll-mt-16" aria-labelledby="about-heading" data-scroll-fade>
  <div class="mx-auto grid max-w-7xl items-start gap-10 px-6 sm:px-10 lg:grid-cols-[1fr_2fr]">

    <!-- Texto a la izquierda -->
    <div class="text-center lg:text-left">
      <h3
        id="about-heading"
        class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
      >
        Nuestro Equipo
      </h3>
      <p class="mt-4 text-lg leading-8 text-gray-600">
        De Costa Rica, cinco personas con ideas, talento y ganas de
        crear soluciones.
      </p>
    </div>

    <!-- Galería a la derecha -->
    <div
      id="team-gallery"
      class="grid h-auto w-full grid-cols-1 gap-4 md:flex md:h-100 md:flex-row md:gap-2 xl:h-120 xl:gap-3"
      style="touch-action: pan-y;"
    >
      {
        team.map(({ name, role, photo, vcard }, i) => (
          <a
            href={vcard}
            target="_blank"
            rel="noopener"
            aria-label={`Ver vCard de ${name}, ${role}`}
            data-active={i === 1 ? "true" : "false"}
            class="group/panel relative aspect-[4/5] w-full min-w-0 overflow-hidden rounded-2xl bg-brand-mint-dark text-left text-white sm:rounded-3xl md:h-full md:min-h-0 md:w-auto md:grow md:basis-0 md:aspect-auto md:transition-[flex-grow] md:duration-700 md:ease-[cubic-bezier(0.4,0,0.2,1)] md:data-[active=true]:grow-[5]"
          >
            {photo ? (
              <img
                src={photo}
                alt={name}
                loading="lazy"
                draggable="false"
                class="absolute inset-0 size-full object-cover object-center"
              />
            ) : (
              <span class="absolute inset-0 flex items-center justify-center text-6xl font-bold">
                {getInitials(name)}
              </span>
            )}

            <div class="absolute inset-0 bg-linear-to-t from-black/55 to-transparent to-55%" />

            <span class="hidden md:absolute md:bottom-6 md:left-1/2 md:block md:-translate-x-1/2 md:rotate-180 md:font-semibold md:tracking-wide md:opacity-100 md:transition-opacity md:duration-300 md:[writing-mode:vertical-rl] md:group-data-[active=true]/panel:opacity-0">
              {name.split(" ")[0]}
            </span>

            <div class="absolute bottom-5 left-5 translate-y-0 whitespace-nowrap opacity-100 transition-all duration-300 md:translate-y-3 md:opacity-0 md:delay-200 md:duration-500 md:group-data-[active=true]/panel:translate-y-0 md:group-data-[active=true]/panel:opacity-100">
              <p class="text-xl font-bold">{name}</p>
              <p class="text-xs tracking-widest opacity-80">{role}</p>
             
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const panels = document.querySelectorAll<HTMLElement>("#team-gallery > a");
  const panelList = [...panels];
  const gallery = document.getElementById("team-gallery");

  const activate = (activePanel: HTMLElement) =>
    panels.forEach((panel) => {
      panel.dataset.active = String(panel === activePanel);
    });

  let activePointerId: number | null = null;
  let startX = 0;
  let startIndex = 0;
  let isDragging = false;
  let suppressNextClick = false;

  panels.forEach((panel) => {
    panel.addEventListener("mouseenter", () => activate(panel));
    panel.addEventListener("focus", () => activate(panel));

    panel.addEventListener("click", (event) => {
      if (suppressNextClick) {
        event.preventDefault();
        suppressNextClick = false;
        return;
      }

      const touchTablet =
        window.matchMedia("(min-width: 768px) and (max-width: 1279px)").matches &&
        navigator.maxTouchPoints > 0;
      if (touchTablet && panel.dataset.active !== "true") {
        event.preventDefault();
        activate(panel);
        return;
      }

      if (panel.dataset.active !== "true") {
        event.preventDefault();
        activate(panel);
      }
    });
  });

  gallery?.addEventListener("pointerdown", (event) => {
    const isTabletWidth = window.matchMedia(
      "(min-width: 768px) and (max-width: 1279px)",
    ).matches;
    if (event.pointerType !== "touch" || !isTabletWidth || panelList.length === 0) return;

    activePointerId = event.pointerId;
    startX = event.clientX;
    startIndex = Math.max(0, panelList.findIndex((panel) => panel.dataset.active === "true"));
    isDragging = false;
    gallery.setPointerCapture(event.pointerId);
  });

  gallery?.addEventListener("pointermove", (event) => {
    if (event.pointerId !== activePointerId || !gallery || panelList.length === 0) return;

    const distance = event.clientX - startX;
    if (!isDragging && Math.abs(distance) > 12) isDragging = true;
    if (!isDragging) return;

    const stepSize = Math.max(44, gallery.getBoundingClientRect().width / panelList.length * 0.55);
    const steps = Math.trunc(distance / stepSize);
    const index = Math.min(panelList.length - 1, Math.max(0, startIndex - steps));
    const panel = panelList[index];
    if (panel) activate(panel);
  });

  const finishPointer = (event: PointerEvent) => {
    if (event.pointerId !== activePointerId) return;

    if (isDragging) {
      suppressNextClick = true;
      window.setTimeout(() => (suppressNextClick = false), 700);
    }

    if (gallery?.hasPointerCapture(event.pointerId)) {
      gallery.releasePointerCapture(event.pointerId);
    }
    activePointerId = null;
    isDragging = false;
  };

  gallery?.addEventListener("pointerup", finishPointer);
  gallery?.addEventListener("pointercancel", finishPointer);
</script>
